---
layout: layouts/base.njk
kind: home
permalink: /
updatedAt: 2026-10-25
---
<header class="masthead photo-hero">
  <div class="photo-hero-media">
    {% set photo = site.homePhoto.src %}
    {% set imageAlt = site.homePhoto.alt %}
    {% set imageLoading = "eager" %}
    {% set imagePriority = "high" %}
    {% include "partials/photo.njk" %}
  </div>
  <div class="photo-hero-shade" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{% include "partials/bolt.njk" %} Independent Formula 1 news for US fans</p>
      <h1>{{ site.name }}</h1>
      <p class="tagline">{{ site.tagline }}</p>
      <p class="brand-line">{{ site.brandLine }}</p>
    </div>
    <div class="hero-panel">
      <p class="panel-kicker">{% include "partials/bolt.njk" %} Race times</p>
      <div class="charge-track" aria-hidden="true"><span class="charge-fill"></span></div>
      <p class="panel-note">Every session in ET, CT, MT and PT. <a href="{{ '/topics/race-times/' | url }}">See race times</a>.</p>
    </div>
  </div>
  {% include "partials/hero-scene.njk" %}
</header>
{% include "partials/energy-divider.njk" %}
<section class="desk-board wrap" aria-labelledby="desks-heading">
  <h2 id="desks-heading" class="section-heading">{% set iconName = "bolt" %}{% include "partials/section-icon.njk" %} Sections</h2>
  <div class="desk-list desk-photo-list">
    {% for item in site.categories %}
    <a class="desk-card desk-photo-card" href="{{ ('/topics/' ~ item.slug ~ '/') | url }}">
      <figure class="desk-photo">
        {% set photo = item.photo %}
        {% set imageAlt = item.photoAlt %}
        {% set imageLoading = "lazy" %}
        {% set imagePriority = false %}
        {% include "partials/photo.njk" %}
      </figure>
      <span class="desk-card-top">{% set iconName = item.slug %}{% include "partials/section-icon.njk" %}<strong>{{ item.name }}</strong></span>
      <span class="desk-photo-copy">{{ item.description }}</span>
      <span class="mini-charge" aria-hidden="true"><span class="mini-charge-fill"></span></span>
    </a>
    {% endfor %}
  </div>
</section>
<div class="wrap">
  <div class="home-grid">
    <section aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="section-heading">{% set iconName = "bolt" %}{% include "partials/section-icon.njk" %} Latest</h2>
      {% set stories = collections.posts | limit(20) %}
      {% if stories and stories.length %}
      {% set storyHeading = "h3" %}
      {% include "partials/story-list.njk" %}
      {% else %}
      <div class="arrival-panel">
        <p class="arrival-kicker">{% include "partials/bolt.njk" %} The wire</p>
        <h3>First stories land soon</h3>
        <div class="charge-track" aria-hidden="true"><span class="charge-fill"></span></div>
        <p class="empty">No story has been published yet. A story appears here after it leaves draft status with a public source list.</p>
      </div>
      {% endif %}
      {% if collections.posts.length > 20 %}
      <p><a href="{{ '/archive/' | url }}">All stories</a></p>
      {% endif %}
    </section>
    <aside class="home-rail">
      {% include "partials/energy-divider.njk" %}
      <section aria-labelledby="publishing-heading">
      <h2 id="publishing-heading">{% set iconName = "policy" %}{% include "partials/section-icon.njk" %} American hubs</h2>
      <ul class="process">
        {% for hub in site.hubs %}<li><a href="{{ ('/hubs/' ~ hub.slug ~ '/') | url }}">{{ hub.title }}</a></li>{% endfor %}
        <li><a href="{{ '/data/' | url }}">Points table after Austin</a></li>
      </ul>
      <p class="panel-note">{{ site.disclaimerLine }}</p>
      </section>
    </aside>
  </div>
</div>
<section class="faq wrap" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="section-heading">{% set iconName = "policy" %}{% include "partials/section-icon.njk" %} Questions</h2>
  <div class="faq-list">
    {% for item in faq %}
    <article class="faq-item">
      <h3>{{ item.question }}</h3>
      <p>{% for part in item.parts %}{% if part.href %}<a href="{{ part.href | url }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</p>
    </article>
    {% endfor %}
  </div>
</section>
