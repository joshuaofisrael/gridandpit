---
layout: layouts/base.njk
---
<article class="story-page">
  <header class="article-head">
    <p class="story-kicker">
      <a class="chip" href="{{ ('/topics/' ~ (category | categorySlug) ~ '/') | url }}">{% set iconName = category | categorySlug %}{% include "partials/section-icon.njk" %}{{ category }}</a>
      <time datetime="{{ page.date | isoDate }}">{{ page.date | displayDate }}</time>
    </p>
    <h1>{{ title }}</h1>
    <p class="byline">By <a href="{{ '/about/' | url }}">{{ author or site.author }}</a></p>
    {% if label == "analysis" %}
    <p class="piece-label">Analysis</p>
    {% elif label == "speculation" %}
    <p class="piece-label">Speculation</p>
    {% elif label == "opinion" or opinion %}
    <p class="piece-label">Opinion</p>
    {% endif %}
    {% if summary %}
    <p class="dek">{{ summary }}</p>
    {% endif %}
    <p class="last-updated">Last updated <time datetime="{{ (updatedAt or page.date) | isoDate }}">{{ (updatedAt or page.date) | displayDate }}</time></p>
  </header>
  {% if disclaimer == "health" %}
  <p class="article-disclaimer" role="note">This is not health or medical advice. It is a report. A decision about your own health belongs with a qualified clinician.</p>
  {% elif disclaimer == "legal" %}
  <p class="article-disclaimer" role="note">This is not legal advice. It is a report. A decision about your own situation belongs with a lawyer licensed where you live.</p>
  {% elif disclaimer == "financial" %}
  <p class="article-disclaimer" role="note">This is not financial, tax, or investment advice. It is a report. Confirm the figures with the cited source and a qualified adviser.</p>
  {% endif %}
  {% if hero and hero.src %}
  <figure class="story-figure story-hero{% if not (hero.src | imageFilesReady) %} is-slot{% endif %}">
    {% set srcBase = hero.src %}
    {% set imageAlt = hero.alt %}
    {% set imageWidth = hero.width %}
    {% set imageHeight = hero.height %}
    {% set imageLoading = "eager" %}
    {% set imagePriority = "high" %}
    {% include "partials/picture.njk" %}
    <figcaption><a class="figure-source" href="{{ '/image-policy/' | url }}">Source</a></figcaption>
  </figure>
  {% endif %}
  {% include "partials/story-figure.njk" %}
  {% set reads = collections.posts | nextReads(category, page.url, tags, 4) %}
  {% set follow = collections.posts | followUps(page.url, tags, page.date, 3, reads) %}
  {% set background = collections.posts | backgroundReads(page.url, tags, category, 2, reads) %}
  {% set matchedHubs = site.hubs | hubsForTags(tags) %}
  {% set cardPosts = reads %}
  {% if reads.length %}
  {% set midBlock %}
  <aside class="next-reads" aria-label="Keep reading">
    <h2>Keep reading</h2>
    {% include "partials/next-reads.njk" %}
  </aside>
  {% endset %}
  {% else %}
  {% set midBlock = "" %}
  {% endif %}
  <div class="prose">
    {{ content | insertBodyImages(images) | insertAfterParagraph(midBlock) | safe }}
  </div>
  {% if (category | isNewsDesk) or follow.length or background.length or matchedHubs.length %}
  <section class="story-follow" aria-labelledby="follow-heading">
    {% if (category | isNewsDesk) or follow.length %}
    <h2 id="follow-heading">What happened next</h2>
    {% if follow.length %}
    {% set cardPosts = follow %}
    {% include "partials/next-reads.njk" %}
    {% else %}
    <p>Nothing later on this thread is on the site yet.</p>
    {% endif %}
    {% if background.length or matchedHubs.length or (category | isNewsDesk) %}
    <h3>Background</h3>
    {% if background.length %}
    {% set cardPosts = background %}
    {% include "partials/next-reads.njk" %}
    {% endif %}
    <ul class="background-links">
      <li><a href="{{ ('/topics/' ~ (category | categorySlug) ~ '/') | url }}">{{ category }} desk</a></li>
      {% for hub in matchedHubs %}
      <li><a href="{{ ('/hubs/' ~ hub.slug ~ '/') | url }}">{{ hub.title }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% else %}
    <h2 id="follow-heading">Background</h2>
    {% if background.length %}
    {% set cardPosts = background %}
    {% include "partials/next-reads.njk" %}
    {% endif %}
    <ul class="background-links">
      <li><a href="{{ ('/topics/' ~ (category | categorySlug) ~ '/') | url }}">{{ category }} desk</a></li>
      {% for hub in matchedHubs %}
      <li><a href="{{ ('/hubs/' ~ hub.slug ~ '/') | url }}">{{ hub.title }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>
  {% endif %}
  {% if tags and tags.length %}
  <section class="tag-block" aria-labelledby="tags-heading">
    <h2 id="tags-heading">Tags</h2>
    <ul class="tag-list">
      {% for tag in tags %}
      {% if tag != "post" %}
      <li>
        {% if collections.publicTagList and (tag in collections.publicTagList) %}
        <a href="{{ ('/tags/' ~ (tag | slugify) ~ '/') | url }}">{{ tag }}</a>
        {% else %}
        <span>{{ tag }}</span>
        {% endif %}
      </li>
      {% endif %}
      {% endfor %}
    </ul>
  </section>
  {% endif %}
  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Sources</h2>
    {% if sources and sources.length %}
    <ol>
      {% for source in sources %}
      {% set href = source.url | safeHttpUrl %}
      <li>
        {% if href %}
        <a href="{{ href }}">{{ source.title }}<span class="visually-hidden"> (external source)</span></a>
        {% else %}
        {{ source.title }}
        {% endif %}
        <span class="source-meta">
          <span class="source-publisher">{{ source.publisher }}</span>
          <span aria-hidden="true"> · </span>
          <time datetime="{{ source.date | isoDate }}">{{ source.date | displayDate }}</time>
        </span>
      </li>
      {% endfor %}
    </ol>
    {% else %}
    <p>This draft has no sources yet. Add a non-empty sources list before publishing. The production build fails without one.</p>
    {% endif %}
  </section>
  <section class="related next-reads next-reads-end" aria-labelledby="related-heading">
    <h2 id="related-heading">{% if category | isLookupDesk %}Check another{% else %}Related stories{% endif %}</h2>
    {% if category | isLookupDesk %}
    <p>Another page on the <a href="{{ ('/topics/' ~ (category | categorySlug) ~ '/') | url }}">{{ category }} desk</a>.</p>
    {% else %}
    <p>More from the <a href="{{ ('/topics/' ~ (category | categorySlug) ~ '/') | url }}">{{ category }} desk</a>.</p>
    {% endif %}
    {% if reads.length %}
    {% set cardPosts = reads %}
    {% include "partials/next-reads.njk" %}
    {% else %}
    <p>No other published story sits close to this one.</p>
    {% endif %}
  </section>
</article>
